ANTHROPIC_API_KEY=
# Optional but recommended: raises GitHub API rate limit from 60/hr to 5000/hr.
# A fine-grained token with public repo read access is enough.
GITHUB_TOKEN=
# Stripe Payment Link URL for the $49 full report.
STRIPE_PAYMENT_URL=
# Optional: override the evaluation model (default claude-opus-5).
ANTHROPIC_MODEL=
# Feedback delivery. Slack incoming webhook (primary reading surface) —
# create one at api.slack.com/apps for your feedback channel.
SLACK_FEEDBACK_WEBHOOK_URL=
# Supabase durable store (the anon key only has insert rights on the
# agentready_feedback table). Either destination alone is enough.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Stripe restricted key (Checkout Sessions: Read only) — verifies that a
# session is paid before serving the full report.
STRIPE_SECRET_KEY=
# Optional test-mode twin (rk_test_...) used for cs_test_ session ids.
STRIPE_SECRET_KEY_TEST=
# Owner bypass for generating full reports without payment:
# /report?repo=owner/repo&key=<this value>. Keep private.
REPORT_ACCESS_KEY=
